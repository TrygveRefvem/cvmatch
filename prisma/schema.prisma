// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS --- 

enum UserRole {
  ADMIN
  CANDIDATE
  RECRUITER
}

// Add Enum for Candidate Status in a Batch
enum CandidateStatus {
  NEW         // Default status for new candidates
  ROUND_2     // Advanced to second round
  ROUND_3     // Advanced to third round
  FINALIST    // Considered for final decision
  HIRED       // Candidate hired for the position
  REJECTED    // Candidate rejected
}


// --- MODELS --- 

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?   // Added for storing hashed passwords
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  role           UserRole @default(CANDIDATE) // Default role

  accounts       Account[]
  sessions       Session[]
  jobBatches     JobBatch[] // Recruiter can have multiple batches
  analysisResults AnalysisResult[] // Candidate can have multiple analysis results

  stripeCustomerId         String?   @unique // Stores the Stripe Customer ID
  stripeSubscriptionId     String?   @unique // Stores the active Stripe Subscription ID
  stripePriceId            String?   // Stores the price ID of the current plan
  stripeCurrentPeriodEnd   DateTime? // Stores the end date of the current Stripe subscription period

  // Trial Period Fields
  trialEndsAt    DateTime? // Date when the free trial expires
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Model for Job Batches created by Recruiters
model JobBatch {
  id                  String    @id @default(cuid())
  title               String    // Name of the batch (e.g., "Senior Software Engineer Q3")
  description         String?   // Optional details about the batch/job
  jobDescriptionUrl   String?   // URL of the original job description
  jobDescriptionText  String?   @db.Text // Extracted text from URL or direct input
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  userId              String    // Foreign key to User (Recruiter)
  widgetToken         String?   @unique // Unique token for the application widget

  user            User     @relation(fields: [userId], references: [id])
  analysisResults AnalysisResult[] // Batch can have multiple analysis results
}

// Model for storing CV analysis results
model AnalysisResult {
  id                  String    @id @default(cuid())
  userId              String    // Foreign key to User (Candidate)
  jobBatchId          String?   
  jobTitle            String?   // Title of the job analyzed against
  jobDescriptionUrl   String?   // URL of the job description used
  cvText              String?   @db.Text // Raw text extracted from CV
  jobDescriptionText  String?   @db.Text // Raw text extracted from Job Description
  resultJson          Json?     // Detailed structured analysis result from LLM
  matchPercentage     Int?      // Overall match percentage (0-100)
  feedback            Json?     // Feedback for the candidate (potentially structured)
  strengths           Json?     // Candidate strengths (potentially structured/array)
  areasForImprovement Json?     // Areas for improvement (potentially structured/array)
  rejectionSentAt     DateTime? // Timestamp when rejection feedback was sent
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Add the status field
  status              CandidateStatus @default(NEW)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobBatch JobBatch? @relation(fields: [jobBatchId], references: [id], onDelete: Cascade)
}
