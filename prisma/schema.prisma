// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?   // Added for storing hashed passwords
  accounts       Account[]
  sessions       Session[]

  // Trial Period Fields
  trialEndsAt    DateTime? // Date when the free trial expires

  // Stripe Billing Fields
  stripeCustomerId         String?   @unique // Stores the Stripe Customer ID
  stripeSubscriptionId     String?   @unique // Stores the active Stripe Subscription ID
  stripePriceId            String?   // Stores the price ID of the current plan
  stripeSubscriptionStatus String?   // e.g., 'active', 'canceled', 'past_due'

  analysisResults AnalysisResult[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnalysisResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String // Foreign key
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation field

  jobDescriptionUrl String? // URL of the job description analyzed
  jobTitle          String? // Title of the job (extracted?)
  matchPercentage   Int?    // The overall match percentage
  resultJson        Json    // The full JSON response from the analysis API

  @@index([userId, createdAt]) // Index for efficient fetching for a user
}
