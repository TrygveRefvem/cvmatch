// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?   // Added for storing hashed passwords
  accounts       Account[]
  sessions       Session[]

  // Role
  role          String    @default("CANDIDATE") // Default role is CANDIDATE
  // Possible values: CANDIDATE, RECRUITER
  
  // Trial Period Fields
  trialEndsAt    DateTime? // Date when the free trial expires

  // Stripe Billing Fields
  stripeCustomerId         String?   @unique // Stores the Stripe Customer ID
  stripeSubscriptionId     String?   @unique // Stores the active Stripe Subscription ID
  stripePriceId            String?   // Stores the price ID of the current plan
  stripeSubscriptionStatus String?   // e.g., 'active', 'canceled', 'past_due'

  analysisResults AnalysisResult[]
  jobBatches             JobBatch[]       // Relation to JobBatches created by this user
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AnalysisResult {
  id                String    @id @default(cuid())
  userId            String    // Foreign key linking to the User model
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle          String?   // Title of the job description used
  jobDescriptionUrl String?   // URL of the job description
  cvText            String?   // The raw text of the CV (Made optional)
  jobDescriptionText String?  // The raw text of the job description (Made optional)
  resultJson        Json      // The JSON result from OpenAI analysis
  matchPercentage   Int?      // Store the calculated match percentage
  feedback          String?   // Store general feedback
  strengths         String?   // Store identified strengths
  areasForImprovement String? // Store areas for improvement
  questionsToAsk    String?   // Store suggested questions
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relation to JobBatch (optional)
  jobBatchId        String?   // Foreign key linking to a JobBatch (if part of one)
  jobBatch          JobBatch? @relation(fields: [jobBatchId], references: [id], onDelete: SetNull) // If batch deleted, nullify link

  // Field to track when rejection feedback was sent
  rejectionSentAt   DateTime?

  @@index([userId, createdAt]) // Index for efficient fetching for a user
}

// New model for Job Batches managed by Recruiters
model JobBatch {
  id              String    @id @default(cuid())
  title           String    // Name of the batch (e.g., "Senior Software Engineer Q3")
  description     String?   // Optional details about the batch/job
  
  // Job Description details associated with this batch
  jobDescriptionUrl String    // URL of the canonical job description for this batch
  jobDescriptionText String?  // Fetched and stored text from the URL

  widgetToken     String   @unique @default(cuid()) // Added field for external widget identification

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String    // Foreign key linking to the User (Recruiter)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade) // If recruiter deleted, delete batches
  analysisResults AnalysisResult[] // Candidates (AnalysisResults) associated with this batch

  @@index([userId])
}
